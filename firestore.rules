rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin") ||
        (request.auth.token.email != null && request.auth.token.email.lower() == "semegladysev527@gmail.com")
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      // Replaced strict regex with simple string and size checks to avoid Firebase RE2 issues.
      return id is string && id.size() > 0 && id.size() <= 128; 
    }

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Users
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.get('role', 'user') == 'user';
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'reputation', 'xp']) == false);
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Public Profiles
    match /public_profiles/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'reputation', 'xp']) == false);
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Tasks (Private to user)
    match /tasks/{taskId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Chats
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants && 
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // User Generated Public Content
    match /theories/{theoryId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Collaborative and Personal Canvases
    match /canvases/{canvasId} {
      allow read: if true;
      allow create, update: if isSignedIn() && (request.resource.data.get('pixels', null) == null || request.resource.data.pixels is map);
      allow delete: if isAdmin();
    }

    // Forum
    match /forum_threads/{threadId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() || 
        (isSignedIn() && resource.data.authorId == request.auth.uid) ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes', 'reactions', 'commentCount', 'shares', 'bookmarkCount', 'pinned']));
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /forum_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() || 
        (isSignedIn() && resource.data.authorId == request.auth.uid) ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes', 'reactions', 'pokeCount']));
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /postReactions/{targetId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() || 
        (isSignedIn() && resource.data.authorId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasAny(['upvotes', 'downvotes', 'reactions']) == false) ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes', 'reactions']));
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Aha AI Chats (Private to user)
    match /ai_chats/{chatId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Aha AI Memories (Private to user)
    match /ai_memories/{memoryId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /user_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || 
        (isSignedIn() && resource.data.uid == request.auth.uid) ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'reactions', 'comments', 'shares', 'bookmarkCount']));
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // User Stories
    match /user_stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() || 
        (isSignedIn() && resource.data.authorId == request.auth.uid) ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes', 'reactions', 'replies']));
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Admin controlled areas
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promo_codes/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /telemetry/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // SDK Reports
    match /sdk_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Admin Audit Logs
    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // User Notifications (Post activity, comments, replies, reactions)
    match /user_notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
